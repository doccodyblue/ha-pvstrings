  "config_subentries": {
    "string": {
      "title": "PV string",
      "initiate_flow": {
        "user": "Add string",
        "reconfigure": "Edit string"
      },
      "entry_type": "String",
      "step": {
        "user": {
          "title": "Add PV string",
          "description": "Point this at the physical measurement channel, not at a min/max, template or group helper. Aggregate helpers double-count one channel and silently drop another, which is invisible in the plant total and fatal per string.",
          "data": {
            "name": "Name",
            "power_entity": "Power sensor",
            "azimuth": "Azimuth (0 = N, 90 = E, 180 = S, 270 = W)",
            "tilt": "Tilt",
            "kwp": "Nameplate",
            "curtailment_group_id": "Curtailment group",
            "temp_coeff": "Temperature coefficient",
            "mount_type": "Mounting",
            "energy_entity": "Energy sensor (cross-check only)",
            "string_efficiency": "String efficiency override (0 = use plant value)",
            "max_power_w": "Tracker ceiling in W (0 = none)",
            "charger_state_entity": "Charger state (optional, e.g. Victron)"
          }
        },
        "reconfigure": {
          "title": "Edit PV string",
          "description": "Recorded geometry periods:\n{history}",
          "data": {
            "name": "Name",
            "power_entity": "Power sensor",
            "azimuth": "Azimuth (0 = N, 90 = E, 180 = S, 270 = W)",
            "tilt": "Tilt",
            "kwp": "Nameplate",
            "curtailment_group_id": "Curtailment group",
            "temp_coeff": "Temperature coefficient",
            "mount_type": "Mounting",
            "energy_entity": "Energy sensor (cross-check only)",
            "string_efficiency": "String efficiency override (0 = use plant value)",
            "max_power_w": "Tracker ceiling in W (0 = none)",
            "charger_state_entity": "Charger state (optional, e.g. Victron)"
          }
        },
        "geometry": {
          "title": "When does the new geometry apply?",
          "description": "A changed tilt or azimuth is not an edit, it is a new validity period. Past data keeps being evaluated against the geometry that was actually installed -- otherwise the learning layer books a seasonally drifting mounting error as a weather or shading effect.\n\nRecorded periods:\n{history}",
          "data": {
            "geometry_mode": "Applies",
            "valid_from": "Valid from",
            "note": "Note (e.g. \"winter setting\")"
          }
        }
      },
      "error": {
        "helper_overlaps": "This helper aggregates entities that another string already uses. Point each string at its physical channel instead."
      }
    },

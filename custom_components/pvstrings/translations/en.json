  "services": {
    "recalculate": {
      "name": "Recalculate",
      "description": "Fetch a fresh irradiance forecast and rebuild the prediction.",
      "fields": {
        "config_entry_id": {
          "name": "Plant",
          "description": "Which plant to recalculate."
        }
      }
    },
    "reset_learning": {
      "name": "Reset learning",
      "description": "Discard all learned corrections and fall back to pure physics. Measurements are kept.",
      "fields": {
        "config_entry_id": {
          "name": "Plant",
          "description": "Which plant to reset."
        }
      }
    },
    "purge": {
      "name": "Purge raw data",
      "description": "Delete raw five-minute data older than the retention period. Hourly aggregates, geometry and model state are kept.",
      "fields": {
        "config_entry_id": {
          "name": "Plant",
          "description": "Which plant to purge."
        }
      }
    },
    "add_geometry": {
      "name": "Add geometry period",
      "description": "Record a new mounting geometry from a given date. Existing periods are left untouched, so historical data keeps being evaluated correctly.",
      "fields": {
        "config_entry_id": {
          "name": "Plant",
          "description": "Which plant the string belongs to."
        },
        "string_id": {
          "name": "String ID",
          "description": "Subentry ID of the string, as shown in the diagnostics download."
        },
        "azimuth": {
          "name": "Azimuth",
          "description": "0 = north, 90 = east, 180 = south, 270 = west."
        },
        "tilt": {
          "name": "Tilt",
          "description": "0 = horizontal, 90 = vertical."
        },
        "kwp": {
          "name": "Nameplate",
          "description": "Installed DC power in kWp."
        },
        "temp_coeff": {
          "name": "Temperature coefficient",
          "description": "Pmax coefficient in 1/K, e.g. -0.004."
        },
        "valid_from": {
          "name": "Valid from",
          "description": "Start of the new period. Defaults to now."
        },
        "note": {
          "name": "Note",
          "description": "Free text, e.g. \"winter setting\"."
        }
      }
    },
    "backfill_shading": {
      "name": "Backfill shading from history",
      "description": "Reconstruct shading observations from Home Assistant's long-term statistics and a historical irradiance archive. Lets the per-string shading correction start from months of real data instead of waiting a full year of seasons. Safe to run more than once.",
      "fields": {
        "config_entry_id": {
          "name": "Plant",
          "description": "Which plant to backfill."
        },
        "days": {
          "name": "Days of history",
          "description": "How far back to look. Hours without statistics are skipped."
        }
      }
    }
